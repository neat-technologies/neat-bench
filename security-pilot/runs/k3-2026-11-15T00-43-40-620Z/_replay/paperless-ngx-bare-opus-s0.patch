diff --git a/src/paperless/tests/test_drf_hardening.py b/src/paperless/tests/test_drf_hardening.py
new file mode 100644
index 000000000..41090603f
--- /dev/null
+++ b/src/paperless/tests/test_drf_hardening.py
@@ -0,0 +1,135 @@
+import bz2
+import json
+
+from django.contrib.auth.models import User
+from rest_framework import status
+from rest_framework.test import APITestCase
+
+from paperless.drf_hardening import ContentNegotiation
+
+
+class TestDRFParserHardening(APITestCase):
+    """
+    Backport of the DRF 3.18.2 fix for GHSA-3547-9m27-7rxg: request bodies must
+    not be decoded with byte-to-byte codecs named by the client.
+    """
+
+    def setUp(self):
+        super().setUp()
+        self.user = User.objects.create_user(username="temp_admin", password="pw")
+
+    def test_token_endpoint_rejects_bytes_codec_charset(self):
+        """
+        GIVEN:
+            - A JSON body compressed with bz2 and charset=bz2_codec
+        WHEN:
+            - Posting it to the (unauthenticated) token endpoint
+        THEN:
+            - The request is rejected, the body is never decompressed
+        """
+        body = bz2.compress(
+            json.dumps({"username": "temp_admin", "password": "pw"}).encode(),
+        )
+        response = self.client.post(
+            "/api/token/",
+            data=body,
+            content_type="application/json; charset=bz2_codec",
+        )
+        self.assertEqual(response.status_code, status.HTTP_400_BAD_REQUEST)
+        self.assertIn("Unsupported charset", response.content.decode())
+
+    def test_token_endpoint_accepts_text_charset(self):
+        """
+        GIVEN:
+            - A normal JSON body with an explicit utf-8 charset
+        WHEN:
+            - Posting it to the token endpoint
+        THEN:
+            - A token is returned
+        """
+        response = self.client.post(
+            "/api/token/",
+            data=json.dumps({"username": "temp_admin", "password": "pw"}),
+            content_type="application/json; charset=utf-8",
+        )
+        self.assertEqual(response.status_code, status.HTTP_200_OK)
+        self.assertIn("token", response.data)
+
+    def test_api_rejects_bytes_codec_charset(self):
+        """
+        GIVEN:
+            - An authenticated user
+        WHEN:
+            - Posting JSON to an API endpoint using a zlib_codec charset
+        THEN:
+            - The request is rejected
+        """
+        self.client.force_authenticate(user=self.user)
+        response = self.client.post(
+            "/api/documents/bulk_edit/",
+            data=b"x\x9c\xab\xae\x05\x00\x01u\x00\xf9",
+            content_type="application/json; charset=zlib_codec",
+        )
+        self.assertEqual(response.status_code, status.HTTP_400_BAD_REQUEST)
+
+
+class TestDRFNegotiationHardening(APITestCase):
+    """
+    Backport of the DRF 3.18.2 fix for GHSA-33wh-fxxf-88vv: the Accept header
+    must be bounded before it is parsed.
+    """
+
+    def test_accept_list_is_bounded(self):
+        negotiation = ContentNegotiation()
+
+        class FakeRequest:
+            META = {
+                "HTTP_ACCEPT": ",".join(
+                    ['text/html; q="' + ";" * 1000 + '"'] * 50
+                    + ["application/json"] * 200,
+                ),
+            }
+
+        tokens = negotiation.get_accept_list(FakeRequest())
+        self.assertLessEqual(len(tokens), negotiation.max_accept_tokens)
+        for token in tokens:
+            self.assertLessEqual(len(token), negotiation.max_media_type_length)
+        # Over long tokens are skipped, not used to drop following valid ones
+        self.assertIn("application/json", tokens)
+
+    def test_malicious_accept_header_does_not_break_api(self):
+        """
+        GIVEN:
+            - An Accept header packed with huge quoted parameters followed by a
+              valid media type
+        WHEN:
+            - Requesting an API endpoint
+        THEN:
+            - The request is served normally using the valid media type
+        """
+        user = User.objects.create_superuser(username="temp_admin")
+        self.client.force_authenticate(user=user)
+        accept = ", ".join(
+            ['text/html; q="' + ";" * 5000 + '"'] * 20
+            + ["application/json; version=8"],
+        )
+        response = self.client.get("/api/tags/", HTTP_ACCEPT=accept)
+        self.assertEqual(response.status_code, status.HTTP_200_OK)
+
+    def test_normal_accept_header_versioning(self):
+        """
+        GIVEN:
+            - A normal versioned Accept header
+        WHEN:
+            - Requesting an API endpoint
+        THEN:
+            - The requested API version is negotiated as before
+        """
+        user = User.objects.create_superuser(username="temp_admin")
+        self.client.force_authenticate(user=user)
+        response = self.client.get(
+            "/api/tags/",
+            HTTP_ACCEPT="application/json; version=7",
+        )
+        self.assertEqual(response.status_code, status.HTTP_200_OK)
+        self.assertEqual(response.renderer_context["request"].version, "7")
